rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'atmanganat@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Numbers Collection
    match /numbers/{numberId} {
      function isValidNumber(data) {
        return data.prefix is string && data.prefix.size() <= 3 &&
               data.full_number is string && data.full_number.size() <= 10 &&
               data.price is number && data.price >= 0 &&
               data.category in ['VİP', 'Qızıl', 'Gümüş', 'Ardıcıl'] &&
               data.status in ['available', 'sold', 'reserved'] &&
               data.isVip is bool;
      }

      allow read: if true;
      
      allow create: if isAdmin() && 
                      isValidId(numberId) && 
                      isValidNumber(incoming()) &&
                      incoming().createdAt == request.time;
      
      allow update: if isAdmin() && 
                      isValidId(numberId) && 
                      isValidNumber(incoming()) &&
                      incoming().updatedAt == request.time &&
                      incoming().createdAt == existing().createdAt;
      
      allow delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin(); // Only existing admins can add new ones
    }
  }
}
