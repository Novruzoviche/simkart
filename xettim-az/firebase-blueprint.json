{
  "entities": {
    "MobileNumber": {
      "title": "Mobile Number",
      "description": "A mobile number available for sale",
      "type": "object",
      "properties": {
        "prefix": { "type": "string", "description": "Operator prefix (e.g., 050)" },
        "full_number": { "type": "string", "description": "Full 10-digit number" },
        "price": { "type": "number", "description": "Price in AZN" },
        "category": { "type": "string", "enum": ["VİP", "Qızıl", "Gümüş", "Ardıcıl"] },
        "status": { "type": "string", "enum": ["available", "sold", "reserved"] },
        "isVip": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["prefix", "full_number", "price", "category", "status", "isVip"]
    }
  },
  "firestore": {
    "numbers": {
      "schema": "MobileNumber",
      "description": "Collection of all mobile numbers"
    }
  }
}
